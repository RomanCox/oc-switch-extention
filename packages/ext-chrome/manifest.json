{
  "manifest_version": 3,
  "name": "ocswitch",
  "version": "0.1.0",
  "description": "VPN только внутри браузера: весь трафик, список сайтов или ничего.",
  "permissions": ["proxy", "storage", "activeTab", "privacy", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_title": "ocswitch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png",
      "48": "icon/icon-48.png",
      "128": "icon/icon-128.png"
    }
  },
  "options_page": "options.html"
}
